# Build artifacts
node_modules/
.next/
__pycache__/
*.pyc

# Claude Code internal folder — credentials, history, plugin cache
.claude/

# Secrets — never commit
.env
.env.*
*.key
# ...кроме образца: в нём только имена переменных и их смысл, значений нет.
# Без этого исключения список переменных не доезжает до сервера, а он там и нужен.
!.env.example

# DB dumps and backups — real data, local only
backups/

# Backend logs (bind-mounted in docker-compose.yml)
backend/logs/

# Windows deploy/operational scripts — local only
*.bat

# Internal docs and planning files — local only
CLAUDE.md
docs/

# SQL — дампы и разовые скрипты держим локально, они содержат данные
*.sql

# Исключение: миграции схемы. Это DDL без данных, и без них деплой невоспроизводим —
# на сервере после git pull каталога backend/migrations/ просто не было, из-за чего
# шаг «накатить миграции» выполнить нечем. Добавлено 2026-08-16 перед релизом v2.4.0.
!backend/migrations/*.sql

# Fallback-страницы — держим локально до перехода на прод

# Runtime-загрузки файлов сделок (bind-mount, docker создаёт сам)
uploads/

# Разовый бэкфилл реквизитов из выгрузки Битрикс24 — локальный инструмент,
# копируется на сервер напрямую (scp), в репозиторий не идёт

# Разовые python/sql-помощники в КОРНЕВОЙ папке scripts/.
# Ведущий слеш обязателен: без него шаблон матчит папку на любой глубине и утаскивает
# frontend/scripts/ — из-за этого на сервере не оказалось check-nav.mjs и упал prebuild.
# Исправлено 2026-08-16 при выкладке v2.4.0.
/scripts/

# Stray data exports
/*.xlsx
/*.xls
/*.csv
*.md

# Keep DEPLOYMENT.md and README if present
!DEPLOYMENT.md
!README.md

# OS
.DS_Store
Thumbs.db
graphify-out/

# DB dumps — local only
*.dump

# Браузерный компаньон брейнштормов — макеты, не код
.superpowers/

# Локальный корневой сертификат Caddy — свой на каждой машине, в истории не нужен
caddy-local-root.crt
uploads.*
