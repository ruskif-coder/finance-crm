# Reverse proxy для Finance CRM.
#
# {$DOMAIN} подставляется из переменной окружения DOMAIN (см. docker-compose.yml,
# по умолчанию "localhost" — задаётся в .env). Пока DOMAIN=localhost, Caddy не
# обращается к Let's Encrypt (это публичный CA, ему нужен реальный домен,
# проходящий HTTP-01 challenge снаружи) и работает с локально доверенным
# сертификатом — нормально для повседневной локальной работы.
#
# Как только в .env стоит реальный домен (и DNS A-запись на этот домен указывает
# на внешний IP этой машины, и роутер пробрасывает 80/443 сюда) — Caddy при
# следующем перезапуске сам получит и будет продлевать сертификат Let's Encrypt
# для этого домена. Никаких других правок здесь не нужно.
{$DOMAIN} {
	encode gzip

	# Заголовки безопасности (OWASP A5): браузер не будет встраивать приложение
	# во фреймы сторонних сайтов (clickjacking), не станет угадывать MIME-тип
	# ответа (sniff), и при переходах наружу не утечёт Referer с полным URL.
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Бэкенд: всё, что фронтенд раньше звал по http://localhost:8000/api/...,
	# теперь идёт сюда же относительным путём /api/... — тот же origin, что и
	# страницы фронтенда, поэтому CORS на эти запросы из браузера не нужен.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Всё остальное — фронтенд (Next.js, production-сборка, см. CLAUDE.md).
	handle {
		reverse_proxy frontend:3000
	}
}
