# Образец окружения. Значений здесь нет и быть не должно — только имена и смысл.
# Реальный `.env` в гит не попадает (см. .gitignore).
#
# Заведён 31.08.2026 при подготовке релиза: переменных стало двадцать с лишним, списка
# не существовало нигде, а половина из них при отсутствии НЕ РОНЯЕТ сервис, а тихо
# подменяется дефолтом. Забытая строка в таком наборе находится не при старте, а через
# неделю по жалобе пользователя.
#
# Отметки:
#   [!] — без неё сервис не поднимается (RuntimeError на старте). Это хорошо: видно сразу.
#   [~] — есть дефолт. Опасная категория: всё работает, но не так, как задумано.

# ── Compose ──────────────────────────────────────────────────────────────────
# Имя проекта закреплено, чтобы Compose не выводил его из имени папки: переезд каталога
# создавал бы вторые контейнеры при жёстких container_name (так уже было).
COMPOSE_PROJECT_NAME=finance

# Домен основного приложения. Управляет и сертификатом Caddy, и списком CORS в ядре.
# Локально — localhost (Caddy отдаёт самоподписанный сертификат).
DOMAIN=

# ── База и подписи ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=          # [!] пароль finance_user; смена требует ALTER USER в самой базе
SECRET_KEY=                 # [!] подпись JWT ядра; ротация разлогинивает всех

# ── Внешний контур: кабинет паблишера ────────────────────────────────────────
# CABINET_SECRET_KEY ОБЯЗАН отличаться от SECRET_KEY: на этом держится то, что сессия
# сотрудника не работает в кабинете площадки и наоборот.
CABINET_DB_PASSWORD=        # [!] пароль роли БД `cabinet`; она читает только схему pub
CABINET_SECRET_KEY=         # [!] подпись сессий кабинета
CABINET_SERVICE_TOKEN=      # [~] общий секрет кабинета и шлюза ядра. Пусто = шлюз ЗАКРЫТ
                            #     (осознанно): площадка входит и видит задания, но любой
                            #     вердикт отдаёт 503 «не настроен на связь с системой»
CABINET_SITE=               # [~] домен кабинета; дефолт lk.localhost. На проде забыть его
                            #     значит, что Caddy никогда не запросит сертификат на
                            #     реальное имя, а домен отдаст 404 «no matching site»

# ── Песочница HTML5-баннеров ─────────────────────────────────────────────────
# Отдельный origin: там исполняется чужой код. Куку на общий корневой домен ставить
# нельзя никогда — она уедет в песочницу.
SANDBOX_SITE=               # [~] домен раздачи; дефолт sb.localhost
SANDBOX_BASE_URL=           # [~] адрес, который бэкенд подставляет в ссылку предпросмотра.
                            #     Забыт → в кабинете и на карточке сделки пустая белая
                            #     рамка, в логах бэкенда при этом чисто
SANDBOX_FRAME_ANCESTORS=    # [~] кому разрешено встраивать баннер: список origin через
                            #     пробел (основное приложение + кабинет). Забыт → баннер
                            #     грузится, но браузер отказывается его показывать

# ── ОРД (МедиаСкаут) ─────────────────────────────────────────────────────────
ORD_ENV=demo                # [~] demo или prod. Дефолт demo намеренно: регистрация
                            #     маркера в ЕРИР необратима
ORD_LOGIN=                  # [~] без него экран ОРД честно пишет «не настроено»
ORD_PASSWORD=               # [~]
ORD_ALLOW_PROD_WRITE=       # [~] вторая защёлка боевой записи: при ORD_ENV=prod отправка
                            #     дополнительно требует значение 1. ВНИМАНИЕ: переменная
                            #     не передана ни одному сервису в docker-compose.yml, то
                            #     есть боевая запись сейчас физически невозможна без
                            #     правки compose. Это защита, а не недоделка

# ── Битрикс24 ────────────────────────────────────────────────────────────────
VIBECODE_API_KEY=           # [~] ключ доступа к API; без него синк отваливается
BITRIX_WEBHOOK_URL=         # [~] ВНИМАНИЕ: тоже не передаётся через compose

# ── Телеграм-бот уведомлений ─────────────────────────────────────────────────
# ВНИМАНИЕ: ни одна из трёх не передаётся через docker-compose.yml. Если прод-файл будет
# взят из гита, доставка в Телеграм отключится МОЛЧА — отправки лягут в журнал статусом
# queued и человеку не покажутся.
TELEGRAM_BOT_TOKEN=         # [~]
TELEGRAM_BOT_NAME=          # [~] имя бота для deeplink ?start=<код>
TELEGRAM_WEBHOOK_SECRET=    # [~] подпись входящих обновлений

# ── Служебное ────────────────────────────────────────────────────────────────
PDF_SERVICE_URL=            # [~] адрес сайдкара печати; дефолт — имя сервиса в сети
DEBUG=                      # [~] true открывает Swagger/ReDoc. На проде НЕ ставить
LOG_DIR=                    # [~] каталог логов
