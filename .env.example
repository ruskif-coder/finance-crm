# Образец окружения. Значений здесь нет и быть не должно — только имена и смысл.
# Реальный `.env` в гит не попадает (см. .gitignore).
#
# Заведён 31.08.2026 при подготовке релиза: переменных стало двадцать с лишним, списка
# не существовало нигде, а половина из них при отсутствии НЕ РОНЯЕТ сервис, а тихо
# подменяется дефолтом. Забытая строка в таком наборе находится не при старте, а через
# неделю по жалобе пользователя.
#
# Отметки:
#   [!] — без неё сервис не поднимается (RuntimeError на старте). Это хорошо: видно сразу.
#   [~] — есть дефолт. Опасная категория: всё работает, но не так, как задумано.
#
# ФОРМАТ: комментарий ВСЕГДА над строкой, никогда справа от значения.
# Причина замерена 11.09.2026. Парсер dotenv у Compose (и `set -a; . .env` в deploy.sh)
# НЕ отрезает хвост после `#` — он берёт всё до конца строки. Файл, написанный как
#     BACKUPS_DIR=                # [~] дефолт ./backups
# давал переменной значение «# [~] дефолт ./backups», и подстановка `${BACKUPS_DIR:-./backups}`
# дефолт НЕ применяла: значение-то непустое. Для монтируемого каталога это был жёсткий
# отказ всего контура — `service "backend" refers to undefined volume …: invalid compose
# project`, то есть скопировавший этот файл как есть не поднял бы систему вовсе. Для
# остальных переменных хуже: тихо неверное значение вместо дефолта. И при заполнении
# «по образцу» комментарий уезжал бы прямо в пароль.

# ── Compose ──────────────────────────────────────────────────────────────────
# Имя проекта закреплено, чтобы Compose не выводил его из имени папки: переезд каталога
# создавал бы вторые контейнеры при жёстких container_name (так уже было).
COMPOSE_PROJECT_NAME=finance

# Домен основного приложения. Управляет и сертификатом Caddy, и списком CORS в ядре.
# Локально — localhost (Caddy отдаёт самоподписанный сертификат).
DOMAIN=

# ── База и подписи ───────────────────────────────────────────────────────────
# [!] пароль finance_user; смена требует ALTER USER в самой базе
POSTGRES_PASSWORD=
# [!] подпись JWT ядра; ротация разлогинивает всех
SECRET_KEY=

# ── Внешний контур: кабинет паблишера ────────────────────────────────────────
# CABINET_SECRET_KEY ОБЯЗАН отличаться от SECRET_KEY: на этом держится то, что сессия
# сотрудника не работает в кабинете площадки и наоборот.
#
# [!] пароль роли БД `cabinet`; она читает только схему pub
CABINET_DB_PASSWORD=
# [!] подпись сессий кабинета
CABINET_SECRET_KEY=
# [~] общий секрет кабинета и шлюза ядра. Пусто = шлюз ЗАКРЫТ (осознанно): площадка
#     входит и видит задания, но любой вердикт отдаёт 503 «не настроен на связь с системой»
CABINET_SERVICE_TOKEN=
# [~] домен кабинета; дефолт lk.localhost. На проде забыть его значит, что Caddy никогда
#     не запросит сертификат на реальное имя, а домен отдаст 404 «no matching site»
CABINET_SITE=

# ── Песочница HTML5-баннеров ─────────────────────────────────────────────────
# Отдельный origin: там исполняется чужой код. Куку на общий корневой домен ставить
# нельзя никогда — она уедет в песочницу.
#
# [~] домен раздачи; дефолт sb.localhost
SANDBOX_SITE=
# [~] адрес, который бэкенд подставляет в ссылку предпросмотра. Забыт → в кабинете и на
#     карточке сделки пустая белая рамка, в логах бэкенда при этом чисто
SANDBOX_BASE_URL=
# [~] кому разрешено встраивать баннер: список origin через пробел (основное приложение
#     + кабинет). Забыт → баннер грузится, но браузер отказывается его показывать
SANDBOX_FRAME_ANCESTORS=

# ── ОРД (МедиаСкаут) ─────────────────────────────────────────────────────────
# [~] demo или prod. Дефолт demo намеренно: регистрация маркера в ЕРИР необратима
ORD_ENV=demo
# [~] без него экран ОРД честно пишет «не настроено»
ORD_LOGIN=
# [~]
ORD_PASSWORD=
# [~] вторая защёлка боевой записи: при ORD_ENV=prod отправка дополнительно требует
#     значение 1. ВНИМАНИЕ: переменная не передана ни одному сервису в docker-compose.yml,
#     то есть боевая запись сейчас физически невозможна без правки compose. Это защита,
#     а не недоделка
ORD_ALLOW_PROD_WRITE=

# ── Битрикс24 ────────────────────────────────────────────────────────────────
# [~] ключ доступа к API; без него синк отваливается
VIBECODE_API_KEY=
# [~] прямой вебхук портала, второй путь мимо VibeCode
BITRIX_WEBHOOK_URL=

# ── Телеграм-бот уведомлений ─────────────────────────────────────────────────
# Пустой токен = доставки нет: отправки ложатся в журнал статусом queued и человеку не
# показываются. Молча — поэтому пустое значение здесь означает «канал выключен», а не
# «настроим потом».
#
# До 06.09.2026 эти три (и BITRIX_WEBHOOK_URL) НЕ передавались через docker-compose.yml
# вовсе: значение из .env до процесса не доходило, и выглядело это как неверный токен.
# Проброс добавлен; что код читает и чем это доезжает, держит прибор
# backend/tests/test_env_passthrough.py.
#
# [~]
TELEGRAM_BOT_TOKEN=
# [~] имя бота для deeplink ?start=<код>
TELEGRAM_BOT_NAME=
# [~] подпись входящих обновлений
TELEGRAM_WEBHOOK_SECRET=

# ── DSP ─────────────────────────────────────────────────────────
# Аналитическая база — ОТДЕЛЬНЫЙ сервис (timescaledb) и отдельная роль `dsp`. Пароль
# нужен в двух местах compose сразу: самой базе и строке подключения бэкенда, поэтому
# переменная одна, а не две.
#
# Подключение ЛЕНИВОЕ: без DSP_DATABASE_URL бэкенд поднимается как раньше, просто
# коннектор не работает. Базу можно завести позже, чем выложен код.
#
# [!] если поднимаем базу DSP; без неё сервис базы не стартует
DSP_DB_PASSWORD=
# [~] дефолт собран в compose из DSP_DB_PASSWORD
DSP_DATABASE_URL=

# Боевой кабинет в DSP. Пустой токен = коннектор молчит: отправок нет, журнал пуст.
#
# [~] адрес JSON-RPC
DSP_API_URL=
# [~] боевой токен
DSP_ACCESS_TOKEN=
# [~] наш кабинет в DSP
DSP_PARTNER_XXHASH=
# Адрес АДМИНКИ (не JSON-RPC): из неё выпускается ссылка нацеливания, которой трафик
# смотрит баннер на площадке до старта. Без него кнопка честно скажет, что не настроено.
# [~] адрес веб-кабинета DSP, без хвостового слеша
DSP_ADMIN_URL=

# Почтовый гейт — единственная точка, из которой система отправляет письма (13.09.2026).
# Пустой MAIL_SMTP_HOST или MAIL_FROM = почта не настроена: письма не теряются, а ложатся
# в очередь и уходят после настройки. Отправитель — система, ответ получателя уходит
# сотруднику через Reply-To, поэтому ящики сотрудников здесь НЕ нужны.
#
# [~] SMTP корпоративной почты
MAIL_SMTP_HOST=
# [~] 465 для ssl, 587 для starttls; пусто — подставится по режиму
MAIL_SMTP_PORT=
# [~] ssl (по умолчанию) | starttls
MAIL_SMTP_SSL=
# [~] логин ящика
MAIL_SMTP_USER=
# [~] пароль ящика или пароль приложения
MAIL_SMTP_PASSWORD=
# [~] адрес в поле «От кого»
MAIL_FROM=
# [~] имя в поле «От кого», можно по-русски
MAIL_FROM_NAME=

# Демо-контур: свой кабинет и свой токен. Разделение не косметическое — контур пишется
# в журнал отправок, и прогон на демо-стенде не должен попадать в дедуп боевых.
#
# [~] дефолт — боевой адрес
DSP_DEMO_API_URL=
# [~] без него демо-стенд отвечает «нет доступа»
DSP_DEMO_TOKEN=
# [~]
DSP_DEMO_PARTNER_XXHASH=

# ── Weborama (WCM) ───────────────────────────────────────────────────────────
# Верификатор показов. Мы заводим у него проект, кампанию и вставку, получаем пиксель и
# вешаем его на креатив; факт показов оттуда — справочная величина для строки
# «% расхождения с Weborama» в медиаплане.
#
# Этих четырёх строк здесь не было вовсе до 11.09.2026, хотя коннектор настроен и
# работает: новая машина поднялась бы с пустым Weborama, и заведение пикселей молча не
# делало бы ничего. Ровно та «опасная категория», о которой сказано в шапке файла.
#
# Вход по почте и паролю, токен коннектор получает сам и держит в памяти.
#
# [~] адрес API; дефолт https://api-wcm-ru.weborama.io
WEBORAMA_API_URL=
# [~] почта учётной записи в их кабинете
WEBORAMA_EMAIL=
# [~] пароль к ней
WEBORAMA_PASSWORD=
# [~] идентификатор аккаунта, в котором заводим. Без него клиент не знает, за кого
#     действует: account_id уходит в каждый запрос вдобавок к заголовку
WEBORAMA_DEMO_ACCOUNT_ID=

# ── Служебное ────────────────────────────────────────────────────────────────
# Каталог бэкапов НА ХОСТЕ. Одно значение на ТРИ места: сюда пишет `deploy.sh backup`,
# отсюда же читает уборка `deploy.sh retention`, и этот же каталог смонтирован бэкенду
# только на чтение — по нему экран состояния судит о свежести копий.
# Пусто — `./backups` рядом с проектом. На проде указать ТОТ каталог, куда реально
# кладёт копии ночной cron: смонтировать не тот значит смотреть на чужие старые файлы.
# Путь ОТНОСИТЕЛЬНЫЙ обязан начинаться с `./` — Compose иначе считает его именем тома.
#
# [~] дефолт ./backups
BACKUPS_DIR=
# [~] адрес сайдкара печати; дефолт — имя сервиса в сети
PDF_SERVICE_URL=
# [~] true открывает Swagger/ReDoc. На проде НЕ ставить
DEBUG=
# [~] каталог логов
LOG_DIR=
