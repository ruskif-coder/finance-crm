FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# БЕЗ `--reload`. Он стоял здесь с самого начала и попадал на прод: боевой процесс держал
# наблюдателя за файловой системой, тратил на это память и CPU и мог перезапуститься сам
# посреди `docker cp` — то есть ровно в момент выкладки (F3-17 внешнего аудита 11.09.2026).
#
# На применение правок это не влияет: код живёт ВНУТРИ образа, и порядок был и остаётся
# `docker cp` + `docker restart`. Именно рестарт и подхватывает скопированное — перезапуск
# процесса перечитывает файлы независимо от наблюдателя. README обещал обратное
# («хватит restart, потому что --reload»), и это обещание было неверным дважды.
#
# Нужен горячий перезапуск при локальной разработке — добавляйте `--reload` в override
# compose, а не в образ, который уезжает на сервер.
#
# ДВА ПРОЦЕССА (03.11.2026, «страницы стали грузиться с задержками»). С одним тяжёлый запрос одного человека
# (дашборд аккаунта считался 2,7 с) держал процесс, и запросы всех остальных стояли в очереди за ним — тормозило
# у всех сразу. uvicorn читает число процессов из WEB_CONCURRENCY; поднять или вернуть 1 можно в compose без
# пересборки. Больше двух — только с запасом памяти: лимит контейнера 1 ГБ делят процессы и кроны (cron-burst-oom).
# Что для этого переделано: стартовая работа — под замком (`ext_lock.hold_startup_lock`), сессии импорта операций —
# в файлах (`app/import_sync_store.py`). Счётчик входов по IP (`auth._ip_attempts`) остаётся у каждого процесса
# свой — потолок попыток с адреса фактически удваивается; блокировка по почте — в базе и общая.
ENV WEB_CONCURRENCY=2
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
