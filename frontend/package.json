{
  "name": "finance-frontend",
  "version": "2.6.18",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "check-nav": "node scripts/check-nav.mjs",
    "check-money": "node scripts/check-money.mjs",
    "check-overlay": "node scripts/check-overlay.mjs",
    "check-perms": "node scripts/check-perms.mjs",
    "check-login": "node scripts/check-login.mjs",
    "check-tokens": "node scripts/check-tokens.mjs",
    "check-dates": "node scripts/check-dates.mjs",
    "check-tone": "node scripts/check-tone.mjs",
    "check-notify": "node scripts/check-notify.mjs",
    "check-freshness": "node scripts/check-freshness.mjs",
    "lint": "next lint --dir pages --dir components --dir lib",
    "prebuild": "npm run check-nav && npm run check-money && npm run check-overlay && npm run check-inline && npm run check-perms && npm run check-login && npm run check-tokens && npm run check-dates && npm run check-tone && npm run check-notify && npm run check-freshness",
    "build": "next build",
    "start": "next start -p 3000",
    "check-inline": "node scripts/check-inline-components.mjs"
  },
  "dependencies": {
    "axios": "1.8.4",
    "framer-motion": "^12.42.2",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35"
  }
}
